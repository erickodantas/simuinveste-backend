# Porta HTTP. Em desenvolvimento usar 3333.
# Em produção (Render, etc.) NÃO setar — a plataforma injeta a porta sozinha.
PORT=3333

# String de conexão do MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?appName=<app>
MONGO_URI=

# Segredo usado para assinar tokens JWT (algoritmo HS256).
# Gerar valor longo e aleatório, ex.: `openssl rand -base64 48`.
JWT_SECRET=

# Ambiente de execução. Em produção setar como `production`.
# Quando != 'production', habilita o bypass de auth via DEV_FAKE_USER_ID
# e o CORS aceita qualquer Origin.
NODE_ENV=development

# Lista de origens permitidas no CORS, separadas por vírgula.
# Ex.: https://app.simuinveste.com.br,https://staging.simuinveste.com.br
# Deixar vazio quando o consumidor é app mobile (não envia header Origin).
CORS_ORIGIN=

# TTL (minutos) da cache de taxas BCB no Mongo. Default 720 (12h).
# Setar 0 força refresh em toda chamada (útil em dev).
TAXAS_TTL_MIN=720

# DEV ONLY — ObjectId válido de usuário usado para bypass do authMiddleware.
# Ativo apenas quando NODE_ENV != 'production'.
# Permite testar rotas autenticadas via REST Client/Postman sem login no frontend.
# NUNCA setar em produção.
DEV_FAKE_USER_ID=
